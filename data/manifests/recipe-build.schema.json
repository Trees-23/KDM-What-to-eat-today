{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe-build.schema.json",
  "title": "Recipe graph CSV build manifest",
  "type": "object",
  "required": [
    "schema_version",
    "producer_version",
    "source_manifest_sha256",
    "source_files",
    "node_count",
    "relationship_count",
    "node_counts",
    "relationship_counts",
    "stable_id_summary",
    "pds_milvus_mapping",
    "csv_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": { "const": "recipe-build-manifest-v1" },
    "producer_version": { "const": "recipe_graph_csv_producer_v1" },
    "source_manifest_sha256": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "node_count": { "type": "integer", "minimum": 1 },
    "relationship_count": { "type": "integer", "minimum": 1 },
    "node_counts": {
      "type": "object",
      "required": ["Recipe", "Ingredient", "CookingStep"],
      "additionalProperties": false,
      "properties": {
        "Recipe": { "type": "integer", "minimum": 1 },
        "Ingredient": { "type": "integer", "minimum": 1 },
        "CookingStep": { "type": "integer", "minimum": 1 }
      }
    },
    "relationship_counts": {
      "type": "object",
      "required": ["REQUIRES", "CONTAINS_STEP"],
      "additionalProperties": false,
      "properties": {
        "REQUIRES": { "type": "integer", "minimum": 1 },
        "CONTAINS_STEP": { "type": "integer", "minimum": 1 }
      }
    },
    "stable_id_summary": {
      "type": "object",
      "required": ["algorithm", "node_ids_sha256", "relationship_ids_sha256"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256-prefix-decimal-v1" },
        "node_ids_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "relationship_ids_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "pds_milvus_mapping": {
      "type": "object",
      "required": ["status", "reason"],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "unbound" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "csv_sha256": {
      "type": "object",
      "required": ["nodes.csv", "relationships.csv"],
      "properties": {
        "nodes.csv": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "relationships.csv": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
