{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe-build.schema.json",
  "title": "Recipe graph CSV build manifest",
  "type": "object",
  "required": [
    "schema_version",
    "producer_version",
    "source_files",
    "node_count",
    "relationship_count",
    "node_counts",
    "relationship_counts",
    "stable_id_summary",
    "pds_milvus_mapping",
    "csv_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": { "const": "recipe-build-manifest-v1" },
    "producer_version": { "const": "recipe_graph_csv_producer_v1" },
    "source_manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "node_count": { "type": "integer", "minimum": 1 },
    "relationship_count": { "type": "integer", "minimum": 1 },
    "node_counts": { "type": "object" },
    "relationship_counts": { "type": "object" },
    "stable_id_summary": {
      "type": "object",
      "required": ["algorithm", "node_ids_sha256", "relationship_ids_sha256"]
    },
    "pds_milvus_mapping": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": { "status": { "const": "unbound" } }
    },
    "csv_sha256": {
      "type": "object",
      "required": ["nodes.csv", "relationships.csv"],
      "properties": {
        "nodes.csv": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "relationships.csv": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
