# 复制为 .env 后，替换所有 CHANGE_ME 值。不要提交 .env。
# 本 Compose 文件只管理自己的 Docker 卷，不会连接或清空外部数据库。

# 基础服务账号。请使用随机的长密码。
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
NEO4J_DATABASE=neo4j
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY

# 模型。首次启动自动下载到 Docker 卷，后续启动复用缓存。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LLM_MODEL=moonshot-v1-8k
RERANK_MODEL=BAAI/bge-reranker-base
ENABLE_RERANK=false

# OpenAI 兼容接口配置
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# 可选：受限网络下载模型或调用模型服务时设置代理。
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890
# ALL_PROXY=socks5://host.docker.internal:7890

# 前端环境变量 (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
