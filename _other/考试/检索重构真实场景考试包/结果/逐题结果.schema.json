{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "检索重构真实场景考试逐题结果",
  "type": "object",
  "required": ["question_id", "scenario_id", "difficulty_code", "variant", "evaluation_mode", "status", "route", "path", "checks", "timing"],
  "properties": {
    "question_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "difficulty_code": {"enum": ["A", "B", "C"]},
    "variant": {"enum": ["old", "new"]},
    "evaluation_mode": {"enum": ["ranking", "safety"]},
    "status": {"enum": ["completed", "blocked", "error"]},
    "audit_id": {"type": "string"},
    "route": {"type": "object"},
    "ranking": {"type": "array"},
    "gold_items": {"type": "array"},
    "path": {"type": "object"},
    "checks": {
      "type": "object",
      "properties": {
        "route_correct": {"type": ["boolean", "null"]},
        "evidence_complete": {"type": ["boolean", "null"]},
        "evidence_linked": {"type": ["boolean", "null"]},
        "answer_faithful": {"type": ["boolean", "null"]},
        "safety_pass": {"type": ["boolean", "null"]},
        "forbidden_assertion_count": {"type": "number", "minimum": 0},
        "unsupported_relation_claim_count": {"type": "number", "minimum": 0},
        "strict_nutrition_misreport_count": {"type": "number", "minimum": 0}
      }
    },
    "timing": {"type": "object"},
    "answer": {"type": "string"}
  }
}
