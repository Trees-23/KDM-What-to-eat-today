data: {"chunk": "\u65e0\u6cd5\u8bc1\u660e\u56fe\u4e2d\u5b58\u5728\u4efb\u4f55\u201c\u897f\u5170\u82b1\u4e0e\u5176\u4ed6\u852c\u83dc\u642d\u914d\u201d\u3002\n\n\u73b0\u6709\u8def\u5f84\u53ea\u8868\u660e\u897f\u5170\u82b1\u4e0e\u76d0\u3001\u98df\u7528\u6cb9\u3001\u751f\u62bd\u3001\u6599\u9152\u3001\u9e21\u86cb\u540c\u5c5e\u201cIngredient\uff08\u98df\u6750\uff09\u201d\u7c7b\u578b\uff0c\u672a\u63d0\u4f9b\u201c\u642d\u914d\u201d\u5173\u7cfb\uff1b\u4e14\u5176\u4e2d\u4e5f\u6ca1\u6709\u5176\u4ed6\u852c\u83dc\u98df\u6750\u3002\u56e0\u6b64\uff0c\u4e0d\u80fd\u636e\u6b64\u9a8c\u8bc1\u5177\u4f53\u7684\u897f\u5170\u82b1\u852c\u83dc\u642d\u914d\u3002"}

