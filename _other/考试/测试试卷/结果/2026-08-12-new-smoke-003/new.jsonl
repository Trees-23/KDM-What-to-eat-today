ent": "INGREDIENT_RECIPES", "database_timestamp": "2026-08-12T05:50:09.911+00:00"}, {"stage": "targeted_graph", "status": "verified", "start": "2026-08-12T05:50:09.913", "end": "2026-08-12T05:50:09.913", "duration_ms": 0, "template_id": "ingredient_recipes_v1", "intent": "INGREDIENT_RECIPES", "database_timestamp": "2026-08-12T05:50:09.911+00:00", "result_count": 5}], "graph_template": null, "graph_paths": [], "vector_scope": {"observed_route": "targeted_graph"}, "pds_hydration": [{"parent_id": "201001630", "audit_file": "recall_content.md", "body_present": true}, {"parent_id": "201002555", "audit_file": "recall_content.md", "body_present": true}, {"parent_id": "201002797", "audit_file": "recall_content.md", "body_present": true}, {"parent_id": "201003196", "audit_file": "recall_content.md", "body_present": true}, {"parent_id": "201003314", "audit_file": "recall_content.md", "body_present": true}], "final_evidence": [{"audit_file": "recall_content.md", "graph_fact_count": 1, "pds_parent_ids": ["201001630", "201002555", "201002797", "201003196", "201003314"]}]}, "checks": {"route_correct": true, "evidence_complete": true, "evidence_linked": true, "answer_faithful": true, "safety_pass": null, "forbidden_assertion_count": 0, "unsupported_relation_claim_count": 0, "strict_nutrition_misreport_count": 0}, "timing": {"ttft_ms": null, "total_latency_ms": 14200}, "answer": "家里有**牛肉**，知识库中已验证可做以下 5 道菜：\n\n1. **尖椒炒牛肉**  \n   适合快炒；牛肉需先用姜、盐、酱油和糖腌制 30–40 分钟，再与尖椒同炒。\n\n2. **巴基斯坦牛肉咖喱**  \n   偏辣、慢炖风味；搭配番茄、螺丝椒、酸奶和 Masala 粉，炖煮约 2–3 小时。\n\n3. **水煮牛肉**  \n   川菜风味，麻辣鲜香；牛肉切片腌制后入红汤煮熟，配豆芽、豆瓣酱、辣椒等。\n\n4. **西红柿土豆炖牛肉**  \n   家常炖菜；牛肉与西红柿、土豆同炖，烹饪约 60–90 分钟。\n\n5. **酱牛肉**  \n   需较长时间处理；牛肉先浸泡去血水、焯水，再加入香料小火炖煮约 3 小时，冷却后切片。\n\n**限制与不可证明项：**当前没有额外限制；知识库也未提供营养、热量、低脂或饮食推荐方面的已验证信息，因此无法据此判断哪一道更健康或更适合特定饮食需求。", "exam_note": ""}
