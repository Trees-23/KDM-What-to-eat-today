data: {"chunk": "\u8bf7\u544a\u8bc9\u6211\u9700\u8981\u814c\u5236\u7684\u5177\u4f53\u8089\u7c7b\u3001\u91cd\u91cf\u548c\u70f9\u8c03\u65b9\u5f0f\uff08\u7092\u3001\u70b8\u3001\u714e\u6216\u70e4\uff09\u3002\u6211\u4f1a\u4ec5\u4f9d\u636e\u201c\u814c\uff08\u8089\uff09\u201d\u7ae0\u8282\u63d0\u4f9b\u76f8\u5e94\u7684\u814c\u6599\u3001\u624b\u6cd5\u4e0e\u65f6\u95f4\u5efa\u8bae\u3002"}

